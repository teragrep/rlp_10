<FindBugsFilter>
    <!-- Ignore expose internal representation by returning Metrics.metricRegistry bug, as MetricsRegistry is mutable by design -->
    <Match>
        <Class name="com.teragrep.rlp_10.Metrics"/>
        <Method name="registry" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
    <!-- Ignore expose internal representation by returning Metrics.metricRegistry bug, as MetricsRegistry is mutable by design -->
    <Match>
        <Class name="com.teragrep.rlp_10.report.PrometheusMetricsReport"/>
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <!-- Ignore path traversal in configuration files -->
    <Match>
        <Class name="com.teragrep.rlp_10.config.TransportConfig"/>
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>
    <!-- Ignore absolute filenames in test classes -->
    <Match>
        <Class name="com.teragrep.rlp_10.config.ConfigFactoryTest"/>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME" />
    </Match>
</FindBugsFilter>